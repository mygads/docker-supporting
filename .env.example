# ===================================================================================
# SUPPORTING SERVICES - ENVIRONMENT CONFIGURATION
# ===================================================================================
#
# RabbitMQ, Prometheus, Grafana, Loki, Promtail, pgAdmin
# Shared infrastructure untuk semua services
#
# USAGE:
#   cp .env.example .env
#   docker compose up -d
#
# ===================================================================================

# ==================== RABBITMQ ====================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ==================== GRAFANA ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here
GRAFANA_URL=https://grafana.genfity.com

# ==================== PROMETHEUS ====================
# Basic Auth (generate with: htpasswd -nB admin)
PROMETHEUS_AUTH=admin:$apr1$YOUR_HASH_HERE

# ==================== PGADMIN ====================
PGADMIN_EMAIL=admin@genfity.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ==================== TIMEZONE ====================
TZ=Asia/Jakarta
