# ===================================================================================
# SUPPORTING SERVICES - ENVIRONMENT CONFIGURATION
# ===================================================================================
#
# RabbitMQ, Prometheus, Grafana, Loki, Promtail, pgAdmin
# Shared infrastructure untuk semua services
#
# USAGE:
#   cp .env.example .env
#   docker compose up -d
#
# ===================================================================================

# ==================== RABBITMQ ====================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ==================== PGADMIN ====================
PGADMIN_EMAIL=admin@genfity.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ==================== TIMEZONE ====================
TZ=Asia/Jakarta
